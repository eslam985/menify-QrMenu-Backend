### =====================================================================
### Menify API tests (VS Code "REST Client" extension)
### Run the requests IN ORDER the first time.
### The refresh cookie ("jwt") is stored automatically by REST Client and
### sent to /api/auth/* because its path is /api/auth.
### =====================================================================

@baseUrl = http://localhost:3000

# .env must contain: EMAIL=...  PASSWORD=...   (the account created by request 2.1)
# Edit these two for each NEW registration test (email + slug must be unique):
@regEmail = owner1@test.com
@regSlug = test-cafe-1
@regPassword = Passw0rd!123

# Access token captured from the login request below
@token = {{login.response.body.$.data.accessToken}}


### =====================================================================
### 1. HEALTH
### =====================================================================

### 1.1 Health check -> 200
GET {{baseUrl}}/api/health

### 1.2 Unknown route -> 404 (NOT 401)
GET {{baseUrl}}/api/does-not-exist


### =====================================================================
### 2. REGISTER (public)
### =====================================================================

### 2.1 Register restaurant + admin -> 201, roles must be "5150"
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Test Cafe",
  "slug": "{{regSlug}}",
  "username": "owner one",
  "email": "{{regEmail}}",
  "password": "{{regPassword}}"
}

### 2.2 Same request again -> 409 (slug or email already taken)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Test Cafe",
  "slug": "{{regSlug}}",
  "username": "owner one",
  "email": "{{regEmail}}",
  "password": "{{regPassword}}"
}

### 2.3 Same email, new slug -> 409 "Email already registered" (case-insensitive)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Another Cafe",
  "slug": "another-cafe-xyz",
  "username": "someone else",
  "email": "{{regEmail}}",
  "password": "{{regPassword}}"
}

### 2.4 Privilege escalation attempt: extra "roles" field -> 400 (strict schema)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Hacker Cafe",
  "slug": "hacker-cafe",
  "username": "hacker",
  "email": "hacker@test.com",
  "password": "Passw0rd!123",
  "roles": "5150"
}

### 2.5 Reserved slug -> 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Admin Cafe",
  "slug": "admin",
  "username": "someone",
  "email": "reserved@test.com",
  "password": "Passw0rd!123"
}

### 2.6 Invalid slug format (uppercase/spaces/underscore) -> 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Bad Slug",
  "slug": "Bad_Slug Here",
  "username": "someone",
  "email": "badslug@test.com",
  "password": "Passw0rd!123"
}

### 2.7 Weak password (< 8 chars) -> 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Weak Cafe",
  "slug": "weak-cafe",
  "username": "someone",
  "email": "weak@test.com",
  "password": "123"
}

### 2.8 Uppercase email is normalized to lowercase -> 201 (change slug/email if already used)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "restaurantName": "Case Cafe",
  "slug": "case-cafe-1",
  "username": "case user",
  "email": "CaseUser@Test.COM",
  "password": "Passw0rd!123"
}


### =====================================================================
### 3. LOGIN
### =====================================================================

### 3.1 Login -> 200 + accessToken + Set-Cookie: jwt (HttpOnly, Path=/api/auth)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{regEmail}}",
  "password": "{{regPassword}}"
}

### 3.2 Wrong password -> 401 "Invalid email or password"
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{regEmail}}",
  "password": "wrong-password-123"
}

### 3.3 Unknown email -> 401 (same message + similar response time)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@nowhere.com",
  "password": "whatever123"
}

### 3.4 Email in different case still logs in -> 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{regEmail}}",
  "password": "{{regPassword}}"
}

### 3.5 Missing fields -> 400
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "not-an-email"
}


### =====================================================================
### 4. VERIFY JWT middleware
### =====================================================================

### 4.1 No token -> 401
GET {{baseUrl}}/api/user

### 4.2 Garbage token -> 401
GET {{baseUrl}}/api/user
Authorization: Bearer abc.def.ghi

### 4.3 Valid token -> 200, includes restaurant_name / restaurant_slug
GET {{baseUrl}}/api/user
Authorization: Bearer {{token}}


### =====================================================================
### 5. USER routes (need a valid token from 3.1)
### =====================================================================

### 5.1 Update profile -> 200
PATCH {{baseUrl}}/api/user
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "owner updated"
}

### 5.2 Try to change role -> 400 (strict schema)
PATCH {{baseUrl}}/api/user
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "roles": "5150"
}

### 5.3 Try to change avatar_url via profile update -> 400
PATCH {{baseUrl}}/api/user
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "avatar_url": "https://evil.com/x.png"
}

### 5.4 Empty body -> 400
PATCH {{baseUrl}}/api/user
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 5.5 List active sessions -> 200
# @name sessions
GET {{baseUrl}}/api/user/sessions
Authorization: Bearer {{token}}

### 5.6 Sessions with sorting -> 200
GET {{baseUrl}}/api/user/sessions?sortBy=created_at&sortOrder=DESC
Authorization: Bearer {{token}}

### 5.7 Invalid sortBy -> 400
GET {{baseUrl}}/api/user/sessions?sortBy=password_hash
Authorization: Bearer {{token}}

### 5.8 Delete session with invalid UUID -> 400
DELETE {{baseUrl}}/api/user/sessions/not-a-uuid
Authorization: Bearer {{token}}

### 5.9 Delete a random UUID (not yours) -> 404
DELETE {{baseUrl}}/api/user/sessions/00000000-0000-4000-8000-000000000000
Authorization: Bearer {{token}}

### 5.10 Delete a session of YOURS (first in the list from 5.5)
# WARNING: if it's your current session, the next requests fail with 401 until you login again.
# To test safely: login twice (3.1 two times) then delete the OLDER one.
DELETE {{baseUrl}}/api/user/sessions/{{sessions.response.body.$.data[0].id}}
Authorization: Bearer {{token}}


### =====================================================================
### 6. REFRESH (rotation)
### =====================================================================

### 6.1 Refresh -> 200 + new accessToken + NEW cookie (old one is revoked)
# @name refresh
POST {{baseUrl}}/api/auth/refresh

### 6.2 Use the new access token -> 200
GET {{baseUrl}}/api/user
Authorization: Bearer {{refresh.response.body.$.data}}

### 6.3 Refresh again -> 200 (each call rotates the token)
POST {{baseUrl}}/api/auth/refresh

### 6.4 Refresh WITHOUT cookie -> 401
# Sending an explicit empty Cookie header
POST {{baseUrl}}/api/auth/refresh
Cookie: 

### 6.5 Refresh with a fake token -> 401
POST {{baseUrl}}/api/auth/refresh
Cookie: jwt=thisIsAFakeToken

### 6.6 Token REUSE detection (manual, see steps below)
# 1) Run 3.1 login, then open the Cookie panel / response headers and copy the jwt value => OLD
# 2) Run 6.1 (rotates; OLD is now revoked)
# 3) WAIT 11+ seconds (grace window)
# 4) Replace OLD_TOKEN_HERE below and send:
#    expected: 401, and ALL sessions of that user are revoked
# 5) Then 4.3 must return 401 ("Session ended") even though the access token is still valid
POST {{baseUrl}}/api/auth/refresh
Cookie: jwt=OLD_TOKEN_HERE


### =====================================================================
### 7. AVATAR
### =====================================================================

### 7.1 Upload avatar -> 200 (put a small test.png next to this file)
POST {{baseUrl}}/api/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="profileImage"; filename="test.png"
Content-Type: image/png

< ./test.png
------Boundary--

### 7.2 Upload without a file -> 400
POST {{baseUrl}}/api/avatar
Authorization: Bearer {{token}}

### 7.3 Upload a non-image (e.g. a text file) -> 400
POST {{baseUrl}}/api/avatar
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="profileImage"; filename="fake.png"
Content-Type: image/png

< ./api.http
------Boundary--

### 7.4 Upload without token -> 401
POST {{baseUrl}}/api/avatar

### 7.5 Set avatar from history: URL not in MY history -> 404
PATCH {{baseUrl}}/api/avatar/previous
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "chosenAvatarUrl": "https://res.cloudinary.com/someone-else/image/upload/v1/x.webp"
}

### 7.6 Set avatar from history: use a URL from avatar_history in 4.3 (upload twice first)
PATCH {{baseUrl}}/api/avatar/previous
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "chosenAvatarUrl": "PASTE_URL_FROM_avatar_history_HERE"
}

### 7.7 Delete avatar -> 200 (back to default)
DELETE {{baseUrl}}/api/avatar
Authorization: Bearer {{token}}

### 7.8 Delete avatar again -> 400 (already default)
DELETE {{baseUrl}}/api/avatar
Authorization: Bearer {{token}}


### =====================================================================
### 8. CHANGE PASSWORD (run near the END: it revokes ALL sessions)
### =====================================================================

### 8.1 Wrong current password -> 400
PATCH {{baseUrl}}/api/user/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "wrong-password",
  "newPassword": "NewPassw0rd!456"
}

### 8.2 New password equals current -> 400
PATCH {{baseUrl}}/api/user/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "{{$dotenv PASSWORD}}",
  "newPassword": "{{$dotenv PASSWORD}}"
}

### 8.3 Change password -> 200, cookie cleared, ALL sessions deleted
# After this, update PASSWORD in .env (or change it back) before the next login.
PATCH {{baseUrl}}/api/user/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "{{$dotenv PASSWORD}}",
  "newPassword": "NewPassw0rd!456"
}

### 8.4 Old access token right after -> 401 (no active session)
GET {{baseUrl}}/api/user
Authorization: Bearer {{token}}


### =====================================================================
### 9. LOGOUT
### =====================================================================

### 9.1 Logout -> 204 + cookie cleared
POST {{baseUrl}}/api/auth/logout

### 9.2 Refresh after logout -> 401
POST {{baseUrl}}/api/auth/refresh

### 9.3 Logout again without cookie -> 204 (idempotent)
POST {{baseUrl}}/api/auth/logout

### 9.4 Access token still valid by time, but no session -> 401
GET {{baseUrl}}/api/user
Authorization: Bearer {{token}}

